
server {
    server_name sanju.masaa.shop;

    # Home service
    location / {
        proxy_pass http://127.0.0.1:5001;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Meals service
    location /meals {
        proxy_pass http://127.0.0.1:5002/meals;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Beverages service
    location /beverages {
        proxy_pass http://127.0.0.1:5003/beverages;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Orders service
    location /orders {
        proxy_pass http://127.0.0.1:5004/orders;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }



    # kitchen service
    location /kitchen {
        proxy_pass http://127.0.0.1:5005/kitchen;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
}

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/sanju.masaa.shop/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/sanju.masaa.shop/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}


server {
    if ($host = sanju.masaa.shop) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    server_name sanju.masaa.shop;
    return 404; # managed by Certbot


}
